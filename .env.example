# PERSONAL 전용 프로젝트. 실제 값은 .env.local에만 작성하세요.
PERSONAL_SUPABASE_URL=
PERSONAL_SUPABASE_PUBLISHABLE_KEY=
APP_PUBLIC_URL=
PERSONAL_MCP_CLIENT_ID=
# iPhone 운동 알림: 서버 전용. NEXT_PUBLIC_ 접두어 금지.
PERSONAL_SUPABASE_SECRET_KEY=
PERSONAL_PUSH_VAPID_PUBLIC_KEY=
PERSONAL_PUSH_VAPID_PRIVATE_KEY=
PERSONAL_PUSH_DISPATCH_SECRET=
# FRENGLE 별도 프로젝트 및 별도 OAuth 클라이언트. 개인 값 재사용 금지.
FRENGLE_SUPABASE_URL=
FRENGLE_SUPABASE_PUBLISHABLE_KEY=
FRENGLE_MCP_CLIENT_ID=
